{
  "name": "chronos",
  "type": "module",
  "version": "0.1.0",
  "description": "Interactive Biblical & Church History Timeline",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "start": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0 --port 3000",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0 --port 3000",
    "validate": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "astro": "ASTRO_TELEMETRY_DISABLED=1 astro"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.1.1",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.4.2",
    "svelte": "^5.20.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^5.7.3"
  }
}
